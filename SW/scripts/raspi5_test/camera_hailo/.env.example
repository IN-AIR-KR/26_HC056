# Host kernel driver, firmware and container HailoRT must be compatible with 4.23.0.
HAILO_DEVICE=/dev/hailo0
# Keep parallel compilation modest on Pi; first build downloads dependencies.
BUILD_JOBS=2
# For longer/high-resolution tests, use /dev/shm/arms-raspi5-test (RAM).
# Host publisher must write to the SAME directory; see README.
CAMERA_SHARED_DIR=./shared
