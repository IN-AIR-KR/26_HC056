# A.R.M.S. SITL 시각화 (arms_sim/sitl_viz 가 내보내는 gz 진실값)
#   ros2 launch arms_bringup arms_sitl.launch.py rviz:=true
#
# Fixed Frame 은 map — sitl_viz 가 map 기준으로 TF/Path/Marker 를 낸다.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Color: 110; 110; 110
      Line Style:
        Line Width: 0.03
        Value: Lines
    - Class: rviz_default_plugins/MarkerArray
      Name: Models + guidance acceleration
      Enabled: true
      Topic:
        Value: /arms/viz/markers
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Drone path
      Enabled: true
      Color: 40; 150; 255
      Line Style: Lines
      Line Width: 0.1
      Alpha: 1
      Topic:
        Value: /arms/viz/drone_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Target path
      Enabled: true
      Color: 255; 50; 50
      Line Style: Lines
      Line Width: 0.1
      Alpha: 1
      Topic:
        Value: /arms/viz/target_path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    # TF 는 기본 꺼둔다 — 축 화살표가 기체 메쉬를 가린다. 필요할 때 체크.
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 5
      Show Names: true
      Show Axes: true
      Show Arrows: false
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      # 지상 기체와 42m 상공 표적이 한 화면에 들어오도록 잡은 초기 시점.
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 90
      Focal Point:
        X: 0
        Y: 0
        Z: 25
      Pitch: 0.35
      Yaw: 2.3
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1300
  Displays:
    collapsed: false
  Views:
    collapsed: false
