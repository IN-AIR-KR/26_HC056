<?xml version="1.0"?>
<!--
  A.R.M.S. SITL world (Gazebo Harmonic)
  - 드론(arms_drone)은 PX4가 airframe 4022로 직접 스폰 → 여기 include 안 함
    (스폰 위치 = 발사기 튜브 끝, arms_launcher 가 DetachableJoint 로 물고 있다)
  - 센서 시스템 플러그인(IMU/baro/airspeed/mag/navsat) 포함 → arm 가능
  - target_ball : 날아다니는 표적 (모델명 유지, 비주얼=x500 드론 외형). referee가 set_pose로 비행 + 명중 연출
-->
<sdf version="1.9">
  <world name="arms_sitl">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 지구 중력/자기장/위치 설정 (PX4가 EKF2에서 사용) -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 핵심 시스템 플러그인 -->
    <plugin filename="gz-sim-physics-system"            name="gz::sim::systems::Physics"/>
    <!-- 표적 접촉 센서를 살리는 시스템. 이게 없으면 <sensor type="contact"> 는
         에러 없이 그냥 무시되고 토픽이 아예 안 생긴다. -->
    <plugin filename="gz-sim-contact-system"            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"      name="gz::sim::systems::UserCommands"/>

    <!-- 비행 센서 플러그인 (이게 빠지면 PX4가 Accel/Gyro/baro/mag missing 으로 arm 거부) -->
    <plugin filename="gz-sim-imu-system"          name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"    name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"       name="gz::sim::systems::NavSat"/>

    <!-- 하늘 배경 (카메라가 위를 보므로 균일한 하늘색이 검출에 유리) -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.6 0.78 0.95 1</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 날아다니는 풍선 (referee가 움직임). 기본 고도 30m (referee ALT) -->
    <!-- 표적 2종: referee가 UI 선택(target 파라미터)에 따라 하나만 비행시키고 나머진 HIDE_Z(지하)로 숨김.
         둘 다 z=-100(숨김)으로 스폰. 명중은 거리기반이라 어느 쪽이든 무손상. -->

    <!-- 표적 A: 풍선 (빨간 구) — 기본 -->
    <model name="target_ball">
      <static>false</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="link">
        <!-- 지름 0.5 m (collision·visual 반지름 0.25 를 같이 바꿀 것. sitl_viz 마커 지름도) -->
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
        </collision>
        <!-- 실제 접촉 판정. referee 가 이 토픽을 구독해 명중을 보고한다
             (거리 임계값 방식은 폐기: hit_radius 는 임의 상수였다). -->
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 표적 B: 적 드론 (PX4 x500 외형, model://x500_base 메시 참조).
         이름에 'drone'/'x500' 안 넣음 → referee 자기드론(arms_drone) 식별과 안 겹침. -->
    <model name="target_uav">
      <static>false</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
        </collision>
        <!-- 풍선 표적과 같은 접촉 센서. 시각적으로는 x500 이지만 충돌 형상은
             반경 1.0 구 하나라, 접촉 판정 기준은 두 표적이 동일하다. -->
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="drone_frame">
          <pose>0 0 0.025 0 0 3.141592654</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/NXP-HGD-CF.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_0">
          <pose>0.174 0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_1">
          <pose>-0.174 0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_2">
          <pose>0.174 -0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_3">
          <pose>-0.174 -0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <!-- 프로펠러 (정적): 로터링크pose + prop센터링offset 합성. ccw=0,1 / cw=2,3 -->
        <visual name="drone_prop_0">
          <pose>0.152 -0.32038 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_1">
          <pose>-0.196 0.02762 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_2">
          <pose>0.152 0.02762 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_3">
          <pose>-0.196 -0.32038 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ================================================================
         견착 발사기 (arms_launcher) — 드론을 물고 앙각/방위를 바꾼 뒤 '분리'로 발사
         ================================================================
         ★ collision 이 하나도 없다: 물리적으로 드론 비행을 방해할 수 없게 일부러 뺐다.
           (예전 시도의 실패 원인 = 충돌 형상 있는 구조물이 날아가는 드론을 막음)
         ★ 드론을 붙잡는 것은 DetachableJoint 고정 조인트 하나 → 기울여도 안 떨어진다.
         ★ 관절은 토크 PID 위치제어(적분 포함) → 드론 무게(≈8 N·m)를 버틴다.
         좌표/수치는 arms_sim/launcher_geometry.py 와 같아야 한다:
           모델 원점 = 어깨 피벗, 높이 PIVOT_Z = 1.20
           elev_joint = 90°-앙각 (0=수직, π/2=수평),  az_joint = 방위
           드론 무게중심 = 튜브 +Z 로 CG_DIST(0.801) 지점, 드론 꼬리 = TAIL_FROM_PIVOT(0.61)
         제어는 launcher.py 노드가 gz 토픽으로 한다 (/arms_sim/launcher/*). -->
    <model name="arms_launcher">
      <pose>0 0 1.20 0 0 0</pose>           <!-- PIVOT_Z -->
      <self_collide>false</self_collide>

      <link name="base">
        <gravity>false</gravity>
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <!-- 사람 대신 서 있는 받침대 (지면 → 어깨 높이). visual 만. -->
        <visual name="post">
          <pose>0 0 -0.60 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <visual name="shoulder">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="world_fix" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <link name="yaw_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="az_joint" type="revolute">
        <parent>base</parent>
        <child>yaw_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-3.1416</lower><upper>3.1416</upper><effort>1000</effort><velocity>3</velocity></limit>
          <dynamics><damping>1.0</damping></dynamics>
        </axis>
      </joint>

      <link name="tube">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.08 0 0 0</pose>
          <mass>1.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.002</izz></inertia>
        </inertial>
        <!-- 튜브: 피벗 뒤 0.45m ~ 드론 꼬리(TAIL_FROM_PIVOT 0.61m). 길이 1.06, 중심 +0.08.
             TAIL_FROM_PIVOT 를 바꾸면 length = 0.45 + TAIL, 중심 z = (TAIL - 0.45)/2. -->
        <visual name="tube">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.06</length></cylinder></geometry>
          <material><ambient>0.25 0.32 0.14 1</ambient><diffuse>0.33 0.42 0.18 1</diffuse></material>
        </visual>
      </link>
      <joint name="elev_joint" type="revolute">
        <parent>yaw_link</parent>
        <child>tube</child>
        <axis>
          <xyz>0 1 0</xyz>                 <!-- +Y 로 돌면 튜브(+Z)가 +X 쪽으로 눕는다 -->
          <limit><lower>-0.01</lower><upper>1.5808</upper><effort>1000</effort><velocity>3</velocity></limit>
          <dynamics><damping>1.0</damping></dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>az_joint</joint_name>
        <topic>/arms_sim/launcher/az_cmd</topic>
        <initial_position>0</initial_position>
        <!-- 토크(힘) PID. 속도명령 모드는 실측에서 드론 무게를 못 버티고 처졌다(2026-10-12).
             부하: 드론 1.05kg × 9.81 × 0.80m ≈ 8.2 N·m (수평일 때 최대), 피벗 관성 ≈ 0.78 kg·m².
             P500 → 고유진동 ≈ 25rad/s, D40 → 감쇠비 ≈ 1, I1000 이 남은 처짐을 1초 안에 없앤다.
             (1자유도 진자 모의: 30/40/90° 모두 최종오차 0.1° 이내, 슬루 중 추종지연 ≈ 3°) -->
        <p_gain>500</p_gain>
        <i_gain>1000</i_gain>
        <d_gain>40</d_gain>
        <i_max>40</i_max>
        <i_min>-40</i_min>
        <cmd_max>400</cmd_max>
        <cmd_min>-400</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>elev_joint</joint_name>
        <topic>/arms_sim/launcher/elev_cmd</topic>
        <initial_position>0</initial_position>
        <!-- 토크(힘) PID. 속도명령 모드는 실측에서 드론 무게를 못 버티고 처졌다(2026-10-12).
             부하: 드론 1.05kg × 9.81 × 0.80m ≈ 8.2 N·m (수평일 때 최대), 피벗 관성 ≈ 0.78 kg·m².
             P500 → 고유진동 ≈ 25rad/s, D40 → 감쇠비 ≈ 1, I1000 이 남은 처짐을 1초 안에 없앤다.
             (1자유도 진자 모의: 30/40/90° 모두 최종오차 0.1° 이내, 슬루 중 추종지연 ≈ 3°) -->
        <p_gain>500</p_gain>
        <i_gain>1000</i_gain>
        <d_gain>40</d_gain>
        <i_max>40</i_max>
        <i_min>-40</i_min>
        <cmd_max>400</cmd_max>
        <cmd_min>-400</cmd_min>
      </plugin>

      <!-- 실제 관절 각도 → launcher 노드가 '목표 vs 실제'를 패널에 표시 (처짐 진단용) -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/arms_sim/launcher/joint_state</topic>
        <joint_name>az_joint</joint_name>
        <joint_name>elev_joint</joint_name>
      </plugin>

      <!-- 드론(PX4 가 나중에 스폰) 을 튜브에 고정. 자식 모델이 나타날 때까지 매 스텝 찾다가
           나타나는 순간 '그때의 상대 위치' 로 물린다 → 스폰 위치가 튜브 끝과 맞아야 함
           (px4_sitl.launch.py 가 launcher_geometry.spawn_pose_str() 로 맞춘다). -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>tube</parent_link>
        <child_model>arms_drone_0</child_model>
        <child_link>base_link</child_link>
        <detach_topic>/arms_sim/launcher/detach</detach_topic>
        <attach_topic>/arms_sim/launcher/attach</attach_topic>
        <output_topic>/arms_sim/launcher/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </model>

  </world>
</sdf>
