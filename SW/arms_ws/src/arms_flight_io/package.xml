<?xml version="1.0"?>
<package format="3">
  <name>arms_flight_io</name>
  <version>0.1.0</version>
  <description>Flight-controller I/O adapters: CRSF for hardware and MAVLink for SITL.</description>
  <maintainer email="dev@arms.local">arms</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>arms_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
